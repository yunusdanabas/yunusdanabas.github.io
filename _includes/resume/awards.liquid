<ul class="card-text font-weight-light list-group list-group-flush">
  {%- assign groups = data[1] | group_by: 'date' -%}
  {%- assign groups = groups | sort: 'name' | reverse -%}
  {%- for group in groups -%}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {%- assign date = group.name -%}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <ul class="items ml-1 ml-md-4">
            {%- for content in group.items -%}
              <li>
                <span class="item">
                  {%- if content.url and content.url != '' -%}
                    <a href="{{ content.url }}">{{ content.title }}</a>
                  {%- else -%}
                    {{ content.title }}
                  {%- endif -%}
                  {%- if content.awarder and content.awarder != '' -%}
                    — <span style="font-style: italic;">{{ content.awarder }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
