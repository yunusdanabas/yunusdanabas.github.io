<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-md-3">
          <h6 class="font-weight-bold">{{ content.name }}</h6>
          {% if content.level %}
            <span class="badge badge-secondary">{{ content.level }}</span>
          {% endif %}
        </div>
        <div class="col-md-9">
          <div class="skills-list">
            {% for item in content.keywords %}
              <span class="skill-item">{{ item }}</span>
              {%- unless forloop.last %}, {% endunless %}
            {% endfor %}
          </div>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
